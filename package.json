{
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "^16.6.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "notyf": "^3.10.0",
    "npm": "^10.5.2",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "name": "workspace",
  "version": "2.0.0",
  "main": "dist/main.js",
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-deb": "8.0.0-alpha.10",
    "@electron-forge/maker-rpm": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@types/node": "^25.9.1",
    "electron": "^33.0.2",
    "electron-builder": "^26.15.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "test": "node scripts/ensure-electron-native.cjs && npm run build && node scripts/run-electron-tests.cjs",
    "dataset:prepare": "npm run build && node dist/cli/prepare-dataset.js",
    "images:import": "npm run build && node scripts/run-electron-node.cjs dist/cli/import-images-to-db.js",
    "images:reindex": "npm run build && node scripts/run-electron-node.cjs dist/cli/rebuild-image-index.js",
    "models:download": "npm run build && node dist/cli/download-models.js",
    "eval:retrieval": "npm run build && node scripts/run-electron-node.cjs dist/cli/evaluate-retrieval.js",
    "mcp:build": "npm run build",
    "mcp": "node scripts/run-electron-node.cjs dist/mcp/server.js",
    "start": "npm run build && node scripts/ensure-electron-native.cjs && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-builder --win nsis",
    "make:forge": "npm run build && electron-forge make",
    "bingo": "npx electron-forge import && npm run make"
  },
  "author": "Kydon",
  "license": "MIT",
  "description": "图片读取工具"
}
